<?xml version="1.0" encoding="utf-8"?>
<!-- 로그인 정보(웹 저장소·쿠키)가 클라우드 백업·기기 이전으로 빠져나가지 않게 전부 제외 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
